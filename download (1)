// ============================================================
// views/draft-board.js - The Draft Board view
// ============================================================
// This is the heart of the app: 336-player composite board,
// tap-to-mark, search/filter, and optional Sleeper live sync.

import { getPlayers, getSourceMeta } from '../data.js';
import { board, league, ui } from '../state.js';
import * as sleeper from '../sleeper.js';

const SOURCE_LABELS = {
  bb: 'BrainyBallers SPS',
  sp: 'Sporthiatus composite',
  pv: 'Prior synthesis (PFF/FP/Sharp)',
};

const TIER_LABELS = {
  1: 'TIER 1 · ELITE SF CORNERSTONES',
  2: 'TIER 2 · TOP DIFFERENCE-MAKERS',
  3: 'TIER 3 · STRONG STARTERS',
  4: 'TIER 4 · QB2s & SOLID CONTRIBUTORS',
  5: 'TIER 5 · MID-ROUND VALUE',
  6: 'TIER 6 · VETERANS & UPSIDE',
  7: 'TIER 7 · DEPTH & DART THROWS',
  8: 'TIER 8 · KICKERS',
};

// Module state (held in memory, syncs to localStorage)
let PLAYERS = [];
let SOURCES = {};
let boardState = null;
let leagueConfig = null;
let uiState = null;
let activePlayer = null;
let syncPollTimer = null;
let syncContext = null;       // last successful league context from Sleeper
let sleeperPlayerDB = null;   // cached player DB
let nameLookup = null;        // name -> sleeper_id

// ============================================================
// Init
// ============================================================
export async function init(container) {
  PLAYERS = await getPlayers();
  SOURCES = await getSourceMeta();
  boardState = board.load();
  leagueConfig = league.load();
  uiState = ui.load();

  container.innerHTML = template();
  attachEventListeners();
  render();

  // If user has a saved league and autoSync is on, kick off sync
  if (leagueConfig.leagueId && leagueConfig.autoSync) {
    startLiveSync();
  } else if (leagueConfig.leagueId) {
    // One-shot sync to catch up with the latest picks
    syncOnce().catch(err => showSyncBanner('error', `Sync failed: ${err.message}`));
  }
}

export function teardown() {
  stopLiveSync();
}

