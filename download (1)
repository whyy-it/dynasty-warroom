// ============================================================
// Helpers
// ============================================================
function isHighVar(p) {
  return p.ns >= 2 && (p.hi - p.lo) >= 20;
}

// ============================================================
// Render
// ============================================================
function render() {
  const list = document.getElementById('list');
  if (!list) return;

  const q = (uiState.search || '').trim().toLowerCase();
  const filter = uiState.filter || 'ALL';

  let filtered = PLAYERS.filter(pl => {
    if (['QB','RB','WR','TE','K'].includes(filter)) {
      if (pl.p !== filter) return false;
    } else if (filter === 'MINE') {
      if (!boardState.mine[pl.r]) return false;
    } else if (filter === 'ROOKIE') {
      if (!pl.rookie) return false;
    } else if (filter === 'AVAIL') {
      if (boardState.drafted[pl.r] || boardState.mine[pl.r]) return false;
    } else if (filter === 'HIVAR') {
      if (!isHighVar(pl)) return false;
    }
    if (q) {
      const hay = (pl.n + ' ' + pl.t + ' ' + pl.p).toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  if (filtered.length === 0) {
    list.innerHTML = '<div class="empty">NO PLAYERS MATCH</div>';
    updateCounters();
    return;
  }

  let html = '';
  let lastTier = -1;
  for (const pl of filtered) {
    if (pl.tier !== lastTier) {
      html += `<div class="tier-hdr" data-tier="${pl.tier}">
        <span>${TIER_LABELS[pl.tier] || `TIER ${pl.tier}`}</span>
        <span class="bar"></span>
        <span class="num">#${pl.r}</span>
      </div>`;
      lastTier = pl.tier;
    }
    html += renderCard(pl);
  }
  list.innerHTML = html;
  updateCounters();
}

function renderCard(pl) {
  const isDrafted = !!boardState.drafted[pl.r];
  const isMine = !!boardState.mine[pl.r];
  const draftedBy = boardState.draftedBy[pl.r];
  const classes = ['player'];
  if (isDrafted) classes.push('drafted');
  if (isMine) classes.push('mine');
  if (pl.a && pl.a <= 24) classes.push('young');
  if (pl.a && pl.a >= 30) classes.push('old');

  const rookieTag = pl.rookie ? '<span class="rookie">R</span>' : '';
  const taxiTag = pl.rookie ? '<span class="taxi">TAXI</span>' : '';
  const warnIcon = isHighVar(pl) ? '<span class="warn-icon">⚠</span>' : '';
  const draftedByTag = draftedBy ? `<span class="drafted-by">→ ${escapeHtml(draftedBy)}</span>` : '';

  const rangeStr = pl.ns >= 2
    ? `<span class="range">avg ${pl.avg} · ${pl.lo}–${pl.hi}</span>`
    : `<span class="range">rank ${pl.avg}</span>`;
  const srcStr = `<span class="srcs">${pl.ns} src${pl.ns > 1 ? 's' : ''}</span>`;

  return `<div class="${classes.join(' ')}" data-pos="${pl.p}" data-rank="${pl.r}">
    <div class="rank">${pl.r}</div>
    <div class="pos">${pl.p}</div>
    <div class="info">
      <div class="nameline"><span class="name">${escapeHtml(pl.n)}</span>${warnIcon}</div>
      <div class="sub"><span class="team">${pl.t}</span>${rangeStr}${srcStr}${rookieTag}${taxiTag}${draftedByTag}</div>
    </div>
    <div class="age-badge">${pl.a || '—'}</div>
  </div>`;
}

function escapeHtml(s) {
  if (typeof s !== 'string') return s;
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function updateCounters() {
  const el1 = document.getElementById('cnt-drafted');
  const el2 = document.getElementById('cnt-mine');
  if (el1) el1.textContent = Object.keys(boardState.drafted).length + Object.keys(boardState.mine).length;
  if (el2) el2.textContent = Object.keys(boardState.mine).length;
}

// ============================================================
// Events
// ============================================================
function attachEventListeners() {
  // Tap a player card
  document.getElementById('list').addEventListener('click', (e) => {
    const card = e.target.closest('.player');
    if (!card) return;
    const rank = parseInt(card.dataset.rank, 10);
    const pl = PLAYERS.find(p => p.r === rank);
    if (pl) openPlayerModal(pl);
  });

  // Filters
  document.getElementById('filters').addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    uiState.filter = btn.dataset.pos;
    ui.save(uiState);
    render();
  });

  // Search
  document.getElementById('search').addEventListener('input', (e) => {
    uiState.search = e.target.value;
    ui.save(uiState);
    render();
  });

  // Modal interactions
  document.getElementById('player-modal').addEventListener('click', (e) => {
    if (e.target.id === 'player-modal') { closePlayerModal(); return; }
    const btn = e.target.closest('.modal-btn');
    if (!btn || !activePlayer) return;
    const action = btn.dataset.action;
    handleModalAction(action);
  });

  // Info modal
  document.getElementById('btn-info').addEventListener('click', () => {
    document.getElementById('info-modal').classList.add('show');
  });
  document.getElementById('info-modal').addEventListener('click', (e) => {
    if (e.target.id === 'info-modal' || e.target.id === 'info-close') {
      document.getElementById('info-modal').classList.remove('show');
    }
  });

  // Foot buttons
  document.getElementById('btn-export').addEventListener('click', exportTeam);
  document.getElementById('btn-reset').addEventListener('click', resetBoard);
  document.getElementById('btn-sync').addEventListener('click', () => {
    if (!leagueConfig.leagueId) {
      // Need to set up league sync
      const id = prompt('Enter your Sleeper league ID:\n\n(Find it in the URL when viewing your league on sleeper.com)', '');
      if (!id) return;
      leagueConfig.leagueId = id.trim();
      league.save(leagueConfig);
    }
    syncOnce().catch(err => showSyncBanner('error', `Sync failed: ${err.message}`));
  });
}

function openPlayerModal(pl) {
  activePlayer = pl;
  document.getElementById('modal-name').textContent = pl.n;
  const ageStr = pl.a ? `age ${pl.a}` : 'team';
  document.getElementById('modal-meta').textContent =
    `${pl.p} · ${pl.t} · ${ageStr}${pl.rookie ? ' · rookie (taxi eligible)' : ''} · composite #${pl.r}`;

  let ranksHtml = '<h4>SOURCE RANKINGS</h4>';
  for (const [k, label] of Object.entries(SOURCE_LABELS)) {
    if (pl.ranks[k] !== undefined) {
      ranksHtml += `<div class="rank-row"><span class="src-name">${label}</span><span class="src-val">#${pl.ranks[k]}</span></div>`;
    } else {
      ranksHtml += `<div class="rank-row" style="opacity:0.4"><span class="src-name">${label}</span><span class="src-val">—</span></div>`;
    }
  }
  ranksHtml += `<div class="rank-row composite"><span class="src-name">COMPOSITE AVG</span><span class="src-val">${pl.avg}</span></div>`;
  if (pl.ns >= 2) {
    ranksHtml += `<div class="rank-row"><span class="src-name">Range</span><span class="src-val">${pl.lo} – ${pl.hi}</span></div>`;
    if (isHighVar(pl)) {
      ranksHtml += `<div class="rank-row" style="border-top:1px dashed var(--warn); margin-top:6px; padding-top:8px;"><span class="src-name" style="color:var(--warn)">⚠ HIGH DISAGREEMENT</span><span class="src-val" style="color:var(--warn)">Δ ${(pl.hi - pl.lo).toFixed(1)}</span></div>`;
    }
  }
  // If drafted-by info exists, show it
  const draftedBy = boardState.draftedBy[pl.r];
  if (draftedBy) {
    ranksHtml += `<div class="rank-row" style="border-top:1px solid var(--line); margin-top:8px; padding-top:10px;"><span class="src-name">Drafted by</span><span class="src-val" style="color:var(--text-dim)">${escapeHtml(draftedBy)}</span></div>`;
  }
  document.getElementById('modal-ranks').innerHTML = ranksHtml;
  document.getElementById('player-modal').classList.add('show');
}

function closePlayerModal() {
  document.getElementById('player-modal').classList.remove('show');
  activePlayer = null;
}

function handleModalAction(action) {
  const rank = activePlayer.r;
  if (action === 'mine') board.markMine(boardState, rank);
  else if (action === 'drafted') board.markDrafted(boardState, rank);
  else if (action === 'reset') board.restore(boardState, rank);
  else if (action === 'cancel') { closePlayerModal(); return; }
  closePlayerModal();
  render();
}

function resetBoard() {
  if (!confirm('Reset the entire board? This clears all drafted players and your picks.')) return;
  boardState = { drafted: {}, mine: {}, draftedBy: {} };
  board.save(boardState);
  render();
}

function exportTeam() {
  const mine = PLAYERS.filter(p => boardState.mine[p.r]);
  if (mine.length === 0) {
    alert("No picks yet. Tap a player and choose '★ Mark as my pick' to track your roster.");
    return;
  }
  const byPos = { QB: [], RB: [], WR: [], TE: [], K: [] };
  mine.forEach(p => byPos[p.p].push(p));
  let txt = 'MY DYNASTY ROSTER · 2026 · 10-TEAM SF PPR\n';
  txt += '==========================================\n\n';
  for (const pos of ['QB','RB','WR','TE','K']) {
    if (byPos[pos].length === 0) continue;
    txt += `${pos} (${byPos[pos].length})\n`;
    byPos[pos].forEach(p => {
      const ageStr = p.a ? `age ${p.a}` : 'team';
      txt += `  #${p.r}  ${p.n} · ${p.t} · ${ageStr}${p.rookie ? ' · R (taxi)' : ''}\n`;
    });
    txt += '\n';
  }
  const rookies = mine.filter(p => p.rookie);
  if (rookies.length > 0) {
    txt += `TAXI CANDIDATES (${rookies.length} / 3 slots):\n`;
    rookies.forEach(p => txt += `  · ${p.n} (${p.p}, ${p.t})\n`);
    txt += '\n';
  }
  txt += `TOTAL: ${mine.length} / 23 picks`;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(txt).then(
      () => alert('Roster copied to clipboard!\n\n' + txt),
      () => alert(txt)
    );
  } else {
    alert(txt);
  }
}

// ============================================================
// Sleeper live sync
// ============================================================
function showSyncBanner(kind, message) {
  const slot = document.getElementById('sync-banner-slot');
  if (!slot) return;
  slot.innerHTML = `<div class="sync-banner ${kind}"><span class="dot"></span><span>${escapeHtml(message)}</span></div>`;
  if (kind === 'error') {
    setTimeout(() => { if (slot.firstChild) slot.innerHTML = ''; }, 6000);
  }
}

async function syncOnce() {
  if (!leagueConfig.leagueId) throw new Error('No league ID set');

  showSyncBanner('', 'Syncing with Sleeper…');

  // Load league context and player DB in parallel
  const [context, playersDB] = await Promise.all([
    sleeper.loadLeagueContext(leagueConfig.leagueId),
    sleeper.getPlayers(),
  ]);

  syncContext = context;
  sleeperPlayerDB = playersDB;
  nameLookup = buildSleeperToBoardLookup(playersDB);

  // Look for an active or completed draft
  const draft = await sleeper.getCurrentDraft(leagueConfig.leagueId);
  if (!draft) {
    showSyncBanner('live', `${context.league.name} · no active draft yet · ${context.users.length} owners`);
    leagueConfig.lastSynced = Date.now();
    league.save(leagueConfig);
    return;
  }

  const picks = await sleeper.getDraftPicks(draft.draft_id);
  applyDraftPicks(picks, context);

  const statusText = draft.status === 'complete'
    ? `${context.league.name} · draft complete · ${picks.length} picks synced`
    : draft.status === 'drafting'
      ? `${context.league.name} · LIVE DRAFT · ${picks.length} picks so far`
      : `${context.league.name} · draft ${draft.status} · ${picks.length} picks`;

  showSyncBanner('live', statusText);
  leagueConfig.lastSynced = Date.now();
  league.save(leagueConfig);
  render();
}

// Map Sleeper player IDs back to board ranks via name match
function buildSleeperToBoardLookup(playersDB) {
  // Build: sleeper_id -> board player rank
  const sleeperLookup = sleeper.buildNameLookup(playersDB);
  const result = {};
  for (const pl of PLAYERS) {
    const sid = sleeper.findSleeperId(sleeperLookup, pl.n, pl.p);
    if (sid) result[sid] = pl.r;
  }
  return result;
}

function applyDraftPicks(picks, context) {
  // For each pick, find the corresponding board player and mark drafted
  let newCount = 0;
  for (const pick of picks) {
    const rank = nameLookup[pick.player_id];
    if (!rank) continue; // player not on our board (deep depth)

    const owner = context.rosterMap[pick.roster_id]
      || (pick.picked_by ? context.userMap[pick.picked_by] : null)
      || `Roster ${pick.roster_id}`;

    // Is this the user's own roster?
    const isMine = leagueConfig.rosterId
      ? String(pick.roster_id) === String(leagueConfig.rosterId)
      : false;

    if (isMine) {
      boardState.mine[rank] = true;
      delete boardState.drafted[rank];
      delete boardState.draftedBy[rank];
    } else {
      if (!boardState.drafted[rank]) newCount++;
      boardState.drafted[rank] = true;
      boardState.draftedBy[rank] = owner;
      delete boardState.mine[rank];
    }
  }
  board.save(boardState);
  return newCount;
}

function startLiveSync() {
  stopLiveSync();
  syncOnce().catch(err => showSyncBanner('error', `Sync failed: ${err.message}`));
  syncPollTimer = setInterval(() => {
    syncOnce().catch(err => {
      console.warn('Sync poll failed:', err);
    });
  }, 10000); // every 10 seconds during a live draft
}

function stopLiveSync() {
  if (syncPollTimer) {
    clearInterval(syncPollTimer);
    syncPollTimer = null;
  }
}
